{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soofi.xyz/schemas/portal-spec.json",
  "title": "PortalSpec",
  "description": "Normalized portal delivery contract produced after intake and before scaffolding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deliveryMode",
    "sourceType",
    "changeRequest",
    "openQuestions"
  ],
  "allOf": [
    {
      "if": {
        "properties": { "deliveryMode": { "const": "new_repository" } },
        "required": ["deliveryMode"]
      },
      "then": {
        "required": [
          "designSource",
          "deliveryContext",
          "screens",
          "breakpoints",
          "auth",
          "apis",
          "secrets",
          "infra",
          "testPersonas",
          "datasetRef",
          "hosting"
        ]
      }
    },
    {
      "if": {
        "properties": { "deliveryMode": { "const": "existing_repository" } },
        "required": ["deliveryMode"]
      },
      "then": {
        "required": ["repositoryContext"],
        "properties": {
          "sourceType": { "const": "source_repo" }
        }
      }
    }
  ],
  "properties": {
    "deliveryMode": {
      "type": "string",
      "enum": ["new_repository", "existing_repository"],
      "description": "Whether Hoopa creates a repository or changes an existing project."
    },
    "sourceType": {
      "type": "string",
      "enum": ["figma", "portal_url", "other_design", "source_repo"],
      "description": "Primary design source for new portals, or source_repo for existing-project work."
    },
    "changeRequest": {
      "type": "object",
      "required": ["summary", "scopes", "acceptanceCriteria"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "frontend",
              "backend",
              "infrastructure",
              "testing",
              "deployment"
            ]
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "repositoryContext": {
      "type": "object",
      "required": [
        "repository",
        "baseBranch",
        "featureBranch",
        "writeAuthorized",
        "pullRequestAuthorized"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "baseBranch": { "type": "string", "minLength": 1 },
        "featureBranch": { "type": "string", "minLength": 1 },
        "writeAuthorized": { "const": true },
        "pullRequestAuthorized": { "const": true },
        "pullRequestUrl": { "type": "string", "format": "uri" }
      }
    },
    "designSource": {
      "type": "object",
      "description": "The primary design source used for a new portal.",
      "required": ["reference"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "deliveryContext": {
      "type": "object",
      "description": "Organization-supplied destination and deployment decisions for a new portal.",
      "required": [
        "repository",
        "repositoryVisibility",
        "createRepositoryAuthorized",
        "pullRequestAuthorized",
        "deploymentAuthorized",
        "aws",
        "amplify"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[^\\s/]+/[^\\s/]+$"
        },
        "repositoryVisibility": {
          "type": "string",
          "enum": ["private", "internal", "public"]
        },
        "createRepositoryAuthorized": { "const": true },
        "pullRequestAuthorized": { "const": true },
        "deploymentAuthorized": { "type": "boolean" },
        "aws": {
          "type": "object",
          "required": ["mode"],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["configured", "placeholders"]
            },
            "accountId": {
              "type": "string",
              "pattern": "^\\d{12}$"
            },
            "region": { "type": "string", "minLength": 1 }
          },
          "allOf": [
            {
              "if": {
                "properties": { "mode": { "const": "configured" } },
                "required": ["mode"]
              },
              "then": { "required": ["accountId", "region"] }
            }
          ]
        },
        "amplify": {
          "type": "object",
          "required": ["mode"],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["attach", "configure"]
            },
            "appRef": { "type": "string", "minLength": 1 }
          },
          "allOf": [
            {
              "if": {
                "properties": { "mode": { "const": "attach" } },
                "required": ["mode"]
              },
              "then": { "required": ["appRef"] }
            }
          ]
        }
      }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["route", "purpose", "states"],
        "additionalProperties": false,
        "properties": {
          "route": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "states": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    },
    "breakpoints": {
      "type": "array",
      "minItems": 3,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["name"],
            "properties": { "name": { "const": "mobile" } }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["name"],
            "properties": { "name": { "const": "tablet" } }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["name"],
            "properties": { "name": { "const": "desktop" } }
          }
        }
      ],
      "items": {
        "type": "object",
        "required": ["name", "widthPx"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "enum": ["mobile", "tablet", "desktop"] },
          "widthPx": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "auth": {
      "type": "object",
      "required": ["mode", "callbackEnvKeys"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["none", "magic-link", "password", "SSO", "copy-from-reference"]
        },
        "callbackEnvKeys": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reference": { "type": "string" }
      }
    },
    "apis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "method", "latencyBudgetMs"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "method": {
            "type": "string",
            "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
          },
          "requestShape": { "type": "string" },
          "responseShape": { "type": "string" },
          "upstreams": {
            "type": "array",
            "items": { "type": "string" }
          },
          "latencyBudgetMs": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "purpose", "status"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["discovered", "placeholder"]
          }
        }
      }
    },
    "infra": {
      "type": "object",
      "required": [
        "apiName",
        "functionName",
        "allowedOrigins",
        "memoryMb",
        "timeoutSeconds",
        "provisionedConcurrency",
        "logRetentionDays",
        "alarmTopicArn"
      ],
      "additionalProperties": false,
      "properties": {
        "apiName": { "type": "string", "minLength": 1 },
        "functionName": { "type": "string", "minLength": 1 },
        "allowedOrigins": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri" }
        },
        "memoryMb": {
          "type": "integer",
          "minimum": 128,
          "maximum": 10240
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        },
        "provisionedConcurrency": { "type": "integer", "minimum": 0 },
        "logRetentionDays": {
          "type": "integer",
          "enum": [
            1,
            3,
            5,
            7,
            14,
            30,
            60,
            90,
            120,
            150,
            180,
            365,
            400,
            545,
            731,
            1096,
            1827,
            2192,
            2557,
            2922,
            3288,
            3653
          ]
        },
        "alarmTopicArn": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "testPersonas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "role"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "datasetRef": {
      "type": "object",
      "required": ["location", "format"],
      "additionalProperties": false,
      "properties": {
        "location": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    },
    "hosting": {
      "type": "object",
      "required": ["mode", "customDomain"],
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["amplify-preview"] },
        "customDomain": { "type": "string", "enum": ["out_of_scope_v1"] },
        "amplifyAppRef": { "type": "string" }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Unresolved blockers. Must be empty before scaffolding."
    }
  }
}
